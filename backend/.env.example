
# Set to "true" to route requirements/planning/explanation through the
# configured LLM provider (falling back to the deterministic backend on
# any provider failure or invalid output). Default: false.
FACTORYMIND_LLM_ENABLED=false

# Which provider to use:
#
#   mock      zero network calls, zero API keys. Scripted; safe for local
#             dev and the test suite. This is the default.
#   bob       IBM Bob, over its OpenAI-compatible inference API.
#   watsonx   IBM watsonx.ai / Granite.
#
# An unrecognised value fails loudly at startup rather than silently
# behaving like "disabled".
FACTORYMIND_LLM_PROVIDER=mock

# Optional generic model-id override.
FACTORYMIND_LLM_MODEL=

# Per-call timeout, in seconds. A real watsonx call is far slower than the
# mock, so 60 is a saner floor than the Phase 7A default of 30.
FACTORYMIND_LLM_TIMEOUT_SECONDS=60

# Maximum number of retries AFTER the first attempt for a transient
# failure (timeout/rate-limit/unavailable/malformed output). Total
# attempts made = this value + 1. Never unbounded.
FACTORYMIND_LLM_MAX_RETRIES=2


# IBM Bob (only read when FACTORYMIND_LLM_PROVIDER=bob)
BOB_API_KEY=replace-me-locally-never-commit

# Optional: use a Fabrivium-specific key instead, to keep the service's
# credential separate from a developer's own.
# FACTORYMIND_BOB_API_KEY=

# The model to call. REQUIRED and deliberately not defaulted: Bob's
# catalogue is account-specific, and a guessed model id fails confusingly on
# an account that does not have it. `scripts.bob_smoke` lists yours.
FACTORYMIND_BOB_MODEL=

# Regional inference base URL. The default is us-east.
# FACTORYMIND_BOB_BASE_URL=https://api.us-east.bob.ibm.com/inference/v1

# "Apikey" (default, for an API key) or "Bearer" (for an SSO-issued token).
# FACTORYMIND_BOB_AUTH_SCHEME=Apikey

# Non-secret routing metadata, sent as headers only when set. Absent is the
# normal case — an empty string is a real (invalid) value to some gateways.
# FACTORYMIND_BOB_TEAM_ID=
# FACTORYMIND_BOB_INSTANCE_ID=

# Max tokens per completion.
# FACTORYMIND_BOB_MAX_TOKENS=2000

# FACTORYMIND_BOB_JSON_MODE=true

# IBM watsonx.ai / Granite (only read when FACTORYMIND_LLM_PROVIDER=watsonx)


# Regional watsonx.ai data-plane endpoint. Frankfurt shown; use the host
# matching YOUR watsonx region.
FACTORYMIND_WATSONX_URL=https://eu-de.ml.cloud.ibm.com

# The watsonx.ai project that owns the model deployment.
FACTORYMIND_WATSONX_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Granite model id.
FACTORYMIND_WATSONX_MODEL_ID=ibm/granite-4-h-small

# YOUR IBM Cloud API key. 
FACTORYMIND_WATSONX_API_KEY=replace-me-locally-never-commit



# watsonx.ai date-based API version. Defaults to the version IBM's own
# published text/chat example uses.
# FACTORYMIND_WATSONX_API_VERSION=2023-10-25

# Native JSON mode: json_object (default) | json_schema | text.
# json_object guarantees syntactically valid JSON; the SHAPE is still
# validated by FactoryMind's own Pydantic models either way.
# FACTORYMIND_WATSONX_JSON_MODE=json_object

# Max tokens per completion.
# FACTORYMIND_WATSONX_MAX_TOKENS=2000

# Use a deployment space instead of a project (mutually exclusive with
# FACTORYMIND_WATSONX_PROJECT_ID).
# FACTORYMIND_WATSONX_SPACE_ID=


# FACTORYMIND_WATSONX_IAM_URL=https://iam.cloud.ibm.com/identity/token

# Tests
# Set to 1 to run the REAL watsonx integration tests, which make live,
# billable API calls. Unset/0 (the default) skips them — the normal test
# suite never touches the network or needs credentials.
# FACTORYMIND_RUN_WATSONX_INTEGRATION_TESTS=0
