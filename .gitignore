# ---------------------------------------------------------------------------
# Secrets — NEVER commit these.
#
# backend/.env holds the real IBM Cloud API key used by the Phase 7B
# watsonx provider. Only backend/.env.example (placeholders only) is
# tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Engineer project files — user data, written by the project store.
# The store's location is overridable with FACTORYMIND_PROJECT_DIR.
projects/

